{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["index.html", "scripts/*.mjs", "api/**/*.ts"],
  "project": ["src/**/*.{js,jsx,ts,tsx}", "scripts/**/*.mjs", "api/**/*.ts"],
  "vite": {
    "config": "vite.config.js"
  },
  "ignoreBinaries": ["vercel"],
  "ignoreIssues": {
    "src/lib/goal/calc/index.ts": ["exports"],
    "src/lib/admissionDoc.ts": ["exports"],
    "src/pages/admissionResults/constants.ts": ["exports"],
    "src/data/navigation.ts": ["duplicates"],
    "src/components/mentorApply/FormSectionApplicant.tsx": ["duplicates"],
    "src/components/mentorApply/FormSectionUniversity.tsx": ["duplicates"],
    "src/context/GoalOnboardingContext.tsx": ["exports"],
    "src/lib/goalOnboarding.ts": ["exports"]
  }
}
