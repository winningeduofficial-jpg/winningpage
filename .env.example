# 이 파일에는 실제 값을 절대 넣지 않습니다. 키 이름과 용도만 기록합니다.
# 로컬 개발: 이 파일을 복사해 .env.local(gitignore 처리됨)로 만들고 실제 값을 채우세요.
# Vercel 배포: 아래 값들을 프로젝트 Settings > Environment Variables에 환경(Development/Preview/Production)별로 등록하세요.

# ── 클라이언트 (Vite 빌드타임에 번들에 인라인됨 — 브라우저에 노출되어도 되는 값만) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TOSS_CLIENT_KEY=
# src/pages/Admin.jsx의 위닝 임베딩 프록시 호출 베이스 URL (선택, 관리자 화면 전용 기능)
VITE_RAG_API_BASE_URL=

# ── 서버 (api/ Vercel 서버리스 함수 전용 — 절대 클라이언트에 노출 금지) ──
# api/create-order.js, api/confirm-payment.js, api/create-service-ticket.js 의 Supabase 관리자 클라이언트
WINNING_SUPABASE_URL=
WINNING_SUPABASE_SERVICE_ROLE_KEY=
# api/confirm-payment.js 토스페이먼츠 결제 승인
TOSS_SECRET_KEY=
# api/create-service-ticket.js SSO 티켓 서명 시크릿 (32자 이상 필수)
SSO_SECRET=
# api/create-service-ticket.js 외부 연계 서비스 리다이렉트 대상 URL
SUHAENG_SERVICE_URL=
GOAL_SERVICE_URL=
# api/request-winning-embedding.js 위닝 임베딩 프록시 (관리자 전용 기능, 미사용 시 비워둬도 무방)
RAG_API_BASE_URL=
ADMIN_EMBED_SECRET=

# ── 로컬 전용 (Vercel 등록 금지) ──
# 로컬 dev 서버 전용 관리자 권한 우회 플래그. Vercel(Preview/Production)에는 절대 등록하지 말 것.
VITE_ADMIN_BYPASS=
