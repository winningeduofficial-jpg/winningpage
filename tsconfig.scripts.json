{
  // scripts/ 전용 타입체크 설정. 기본 tsconfig.json은 scripts를 exclude해
  // .mjs 스크립트가 타입체크 사각지대였고, 그 결과 src/lib 리팩토링(export 제거,
  // sql/ 폐기)을 따라가지 못한 채 죽은 스크립트가 2026-09-01 첫 야간 DB 감사에서야
  // 드러났다. 이 파일로 CI(type-check.yml)에서 scripts/도 tsc --noEmit 대상에 넣는다.
  //
  // 1차 편입 시점에는 strictNullChecks 계열 4개를 끈다(전체 238건 중 162건이 이
  // 계열). 나머지는 실제 타입 오류라 전부 고친 상태로 들어온다. 2차에서 계열을
  // 켜고 162건을 정리한다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["scripts/**/*.mjs", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
